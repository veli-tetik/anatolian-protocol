{
  "note": "Business scenarios. Each case is a set of input changes on the loaded plan, computed in full (P&L, monthly cash, funding). A case with no changes is the plan itself. Groups marked holdable can be read two ways on the Scenarios page: the same new-client plan (leads re-solved, so lead spend moves) or the same marketing budget (leads as set, so the client plan moves). Benchmarks: a comparable health-tourism business (CRM and books, Oct 2025 – Jun 2026).",
  "groups": [
    {
      "id": "collection",
      "title": "Collection",
      "note": "When clients pay. Benchmark: a €300 deposit (8%), treatment a median 61 days later, the balance on the day.",
      "cases": [
        {
          "id": "plan",
          "label": "Plan: 70% of the rest at the first visit, 30% over 6 months",
          "changes": []
        },
        {
          "id": "full",
          "label": "Paid in full at the first visit",
          "note": "As the benchmark.",
          "changes": [
            {
              "path": "finance.payment.startShare",
              "value": 1
            },
            {
              "path": "finance.payment.balanceMonths",
              "value": 0
            }
          ]
        },
        {
          "id": "half",
          "label": "50% at the first visit, 50% over 6 months",
          "changes": [
            {
              "path": "finance.payment.startShare",
              "value": 0.5
            },
            {
              "path": "finance.payment.balanceMonths",
              "value": 6
            }
          ]
        },
        {
          "id": "quarter",
          "label": "25% at the first visit, the rest over 12 months",
          "changes": [
            {
              "path": "finance.payment.startShare",
              "value": 0.25
            },
            {
              "path": "finance.payment.balanceMonths",
              "value": 12
            }
          ]
        },
        {
          "id": "late",
          "label": "First visit 4 months after the deposit",
          "note": "A longer wait between sale and arrival; marketing paid 5 months ahead.",
          "changes": [
            {
              "path": "finance.payment.saleToStartMonths",
              "value": 4
            },
            {
              "path": "monthly.marketingLeadMonths",
              "value": 5
            }
          ]
        }
      ]
    },
    {
      "id": "conversion",
